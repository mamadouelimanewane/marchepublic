# Copier vers apps/web/.env.local (développement) ou configurer dans Vercel (production).
# Ne jamais committer de valeurs réelles.

# --- Supabase (URL et clé publique « anon » : utilisables dans le navigateur) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Clé service_role : SERVEUR UNIQUEMENT (création de comptes par l'administrateur, seed). Ne jamais exposer. ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Tâche planifiée d'ancrage du journal d'audit (Vercel Cron envoie « Authorization: Bearer <CRON_SECRET> ») ---
CRON_SECRET=

# --- Intégrations (facultatif) ---
# DGID_SIMULATION=true   # autorise l'endpoint de simulation DGID en production (déconseillé)
