{
  "name": "marchepublic-senegal",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme Intégrée de Pilotage du Cycle des Marchés Publics - Sénégal",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:migrate": "supabase db push",
    "db:seed": "node supabase/seed/index.js",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/db/src/types.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.8.2"
}
