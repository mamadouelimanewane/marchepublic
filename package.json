{
  "name": "marchepublic-senegal",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme Intégrée de Pilotage du Cycle des Marchés Publics - Sénégal",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "turbo test",
    "test:db": "node --test \"supabase/tests/*.test.mjs\"",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:migrate": "supabase db push",
    "db:seed": "node supabase/seed/index.js",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/db/src/types.ts",
    "test:db:remote": "node scripts/test-remote.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.5",
    "pg": "^8.23.1",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.8.2"
}
